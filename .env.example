# Only needed to deploy or upgrade on X Layer testnet. Never commit a real key.
DEPLOYER_PRIVATE_KEY=
# Optional; defaults to the public X Layer testnet RPC.
XLAYER_TESTNET_RPC_URL=
# Mainnet (hardhat.mainnet.config.cjs): a fresh key, never the testnet one, and a paid https RPC.
MAINNET_DEPLOYER_PRIVATE_KEY=
XLAYER_MAINNET_RPC_URL=
